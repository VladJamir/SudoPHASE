# Makefile for compiling the thesis

# Main document
THESIS = thesis
TEXFILE = $(THESIS).tex
PDFFILE = $(THESIS).pdf

# LaTeX compiler
LATEX = pdflatex
BIBTEX = bibtex

# Default target
all: $(PDFFILE)

# Compile PDF
$(PDFFILE): $(TEXFILE)
	$(LATEX) $(TEXFILE)
	# Run bibtex if .bib file exists
	@if [ -f $(THESIS).bib ]; then $(BIBTEX) $(THESIS); fi
	$(LATEX) $(TEXFILE)
	$(LATEX) $(TEXFILE)

# Clean auxiliary files
clean:
	rm -f *.aux *.log *.out *.toc *.bbl *.blg *.lof *.lot *.fls *.fdb_latexmk *.synctex.gz

# Clean everything including PDF
cleanall: clean
	rm -f $(PDFFILE)

# View PDF (Linux)
view: $(PDFFILE)
	xdg-open $(PDFFILE)

# View PDF (Mac)
view-mac: $(PDFFILE)
	open $(PDFFILE)

# View PDF (Windows)
view-win: $(PDFFILE)
	start $(PDFFILE)

.PHONY: all clean cleanall view view-mac view-win































